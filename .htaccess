# TKO Labs — Apache configuration for cPanel
# Upload this file with index.html at the tkolabs.us document root.

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. Leave the AutoSSL ACME challenge reachable over HTTP.
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host: www.tkolabs.us -> tkolabs.us
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Legacy paths from the previous TKO-Agent site.
  RewriteRule ^how(?:\.html)?/?$ /#method [NE,R=301,L]
  RewriteRule ^pricing(?:\.html)?/?$ /#programs [NE,R=301,L]
  RewriteRule ^results(?:\.html)?/?$ /#evidence [NE,R=301,L]
  RewriteRule ^contact(?:\.html)?/?$ /#contact [NE,R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # The page is self-contained. Inline CSS and JS are the only inline sources.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'"

  # Enable HSTS only after HTTPS is confirmed for both the apex and www hosts.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# Do not serve dotfiles, markdown notes, or common backup/config formats.
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
  <FilesMatch "\.(env|ini|log|sh|sql|bak|old|swp|md)$">
    Require all denied
  </FilesMatch>

  # security.txt must remain readable.
  <Files "security.txt">
    Require all granted
  </Files>
</IfModule>
